<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>For You</title>
<style>
  :root {
    --bg: #0a0a12;
    --ink: #f5f3ef;
    --ink-dim: #a8a4b8;
    --accent: #ff5e78;
    box-sizing: border-box;
    padding-top: env(safe-area-inset-top, 0px);
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }
  html { scroll-padding-top: env(safe-area-inset-top, 0px); height: 100%; }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    height: 100%;
    background: var(--bg);
    color: var(--ink);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
    overflow: hidden;
  }

  .stage {
    position: relative;
    width: 100%;
    height: 100vh;
    height: 100dvh;
    display: flex;
    flex-direction: column;
    background: #000;
  }

  .frame {
    position: relative;
    flex: 1;
    min-height: 0;
    overflow: hidden;
    background: #000;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: blur(40px) brightness(0.5) saturate(1.1);
    transform: scale(1.2);
  }

  video.main {
    position: relative;
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    z-index: 1;
    box-shadow: 0 10px 40px rgba(0,0,0,0.5);
  }

  .top {
    position: absolute;
    top: calc(16px + env(safe-area-inset-top, 0px));
    left: 20px;
    right: 20px;
    z-index: 5;
    display: flex;
    justify-content: center;
  }
  .badge {
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--ink-dim);
    background: rgba(0,0,0,0.35);
    padding: 6px 12px;
    border-radius: 999px;
    backdrop-filter: blur(6px);
  }

  .bottom {
    position: absolute;
    bottom: calc(18px + env(safe-area-inset-bottom, 0px));
    left: 0;
    right: 0;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
  }
  .ctrl {
    width: 46px;
    height: 46px;
    border-radius: 999px;
    border: 1px solid rgba(245,243,239,0.2);
    background: rgba(0,0,0,0.4);
    backdrop-filter: blur(6px);
    color: var(--ink);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  .ctrl svg { width: 19px; height: 19px; }

  .intro {
    position: absolute;
    inset: 0;
    z-index: 20;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 40px 28px;
    background: radial-gradient(ellipse at 50% 30%, #22163a 0%, var(--bg) 70%);
  }
  .intro h1 {
    font-family: Georgia, 'Times New Roman', serif;
    font-weight: 400;
    font-size: clamp(30px, 8vw, 42px);
    margin: 0 0 10px;
  }
  .intro p {
    color: var(--ink-dim);
    font-size: 14.5px;
    max-width: 30ch;
    margin: 0 0 30px;
    line-height: 1.5;
  }
  .intro button {
    font-family: inherit;
    font-size: 15px;
    padding: 13px 30px;
    border-radius: 999px;
    border: none;
    background: linear-gradient(120deg, var(--accent), #ff8a5e);
    color: #1a0a0e;
    font-weight: 600;
    cursor: pointer;
  }
  .intro.gone { display: none; }
</style>
</head>
<body>

<div class="stage">
  <div class="intro" id="intro">
    <h1>For You</h1>
    <p>Tap play to watch.</p>
    <button id="startBtn">Play</button>
  </div>

  <div class="top">
    <div class="badge">TEST RUN</div>
  </div>

  <div class="frame">
    <img class="bg" src="poster.jpg" alt="">
    <video class="main" id="mainVideo" src="clip.mp4" poster="poster.jpg" playsinline webkit-playsinline muted preload="auto"></video>
  </div>

  <div class="bottom">
    <button class="ctrl" id="playPause" aria-label="Play or pause">
      <svg id="playIcon" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
    </button>
    <button class="ctrl" id="muteBtn" aria-label="Mute or unmute">
      <svg id="muteIcon" viewBox="0 0 24 24" fill="currentColor"><path d="M3 10v4h4l5 5V5L7 10H3z"/><line x1="16" y1="9" x2="22" y2="15" stroke="currentColor" stroke-width="2"/><line x1="22" y1="9" x2="16" y2="15" stroke="currentColor" stroke-width="2"/></svg>
    </button>
  </div>
</div>

<script>
(function(){
  const v = document.getElementById('mainVideo');
  const intro = document.getElementById('intro');
  const startBtn = document.getElementById('startBtn');
  const playPauseBtn = document.getElementById('playPause');
  const playIcon = document.getElementById('playIcon');
  const muteBtn = document.getElementById('muteBtn');
  const muteIcon = document.getElementById('muteIcon');

  v.load();

  function setPlayIcon(playing) {
    playIcon.innerHTML = playing
      ? '<rect x="6" y="5" width="4" height="14"/><rect x="14" y="5" width="4" height="14"/>'
      : '<path d="M8 5v14l11-7z"/>';
  }
  function setMuteIcon(muted) {
    muteIcon.innerHTML = muted
      ? '<path d="M3 10v4h4l5 5V5L7 10H3z"/><line x1="16" y1="9" x2="22" y2="15" stroke="currentColor" stroke-width="2"/><line x1="22" y1="9" x2="16" y2="15" stroke="currentColor" stroke-width="2"/>'
      : '<path d="M3 10v4h4l5 5V5L7 10H3z"/><path d="M16 8a5 5 0 0 1 0 8" fill="none" stroke="currentColor" stroke-width="2"/><path d="M18.5 5.5a9 9 0 0 1 0 13" fill="none" stroke="currentColor" stroke-width="2"/>';
  }

  startBtn.addEventListener('click', () => {
    intro.classList.add('gone');
    v.play().catch(()=>{});
    setPlayIcon(true);
  });

  playPauseBtn.addEventListener('click', () => {
    if (v.paused) { v.play().catch(()=>{}); setPlayIcon(true); }
    else { v.pause(); setPlayIcon(false); }
  });

  muteBtn.addEventListener('click', () => {
    v.muted = !v.muted;
    setMuteIcon(v.muted);
    if (!v.muted) v.play().catch(()=>{});
  });

  v.addEventListener('ended', () => setPlayIcon(false));
  document.addEventListener('visibilitychange', () => {
    if (document.hidden && !v.paused) { v.pause(); setPlayIcon(false); }
  });
})();
</script>
</body>
</html>
